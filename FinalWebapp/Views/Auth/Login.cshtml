@model FinalWebapp.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null; // Full page login
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Ascension Tracker</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d1b69 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            background: rgba(255, 255, 255, 0.1);
            padding: 2rem;
            border-radius: 16px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            width: 100%;
            max-width: 400px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .logo {
            text-align: center;
            color: #9c27b0;
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            color: #ffffff;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: #9c27b0;
            box-shadow: 0 0 0 2px rgba(156, 39, 176, 0.2);
        }

        .form-group input::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }

        .checkbox-group input {
            width: auto;
            margin-right: 0.5rem;
        }

        .checkbox-group label {
            margin-bottom: 0;
            color: rgba(255, 255, 255, 0.9);
        }

        .admin-mode-group {
            display: flex;
            align-items: center;
            margin-bottom: 1.5rem;
            padding: 0.75rem;
            background: rgba(255, 167, 38, 0.1);
            border: 1px solid rgba(255, 167, 38, 0.3);
            border-radius: 8px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .admin-mode-group:hover {
            background: rgba(255, 167, 38, 0.15);
        }

        .admin-mode-group input {
            width: auto;
            margin-right: 0.5rem;
            cursor: pointer;
        }

        .admin-mode-group label {
            margin-bottom: 0;
            color: #ffa726;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex: 1;
        }

        .admin-icon {
            font-size: 1.2rem;
        }

        .btn-primary {
            width: 100%;
            padding: 0.75rem;
            background: linear-gradient(135deg, #9c27b0, #7b1fa2);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 1rem;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(156, 39, 176, 0.4);
        }

        .btn-primary.admin-mode {
            background: linear-gradient(135deg, #ff9800, #f57c00);
        }

        .btn-primary.admin-mode:hover {
            box-shadow: 0 4px 15px rgba(255, 152, 0, 0.4);
        }

        .btn-secondary {
            width: 100%;
            padding: 0.75rem;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            color: white;
            font-size: 1rem;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            text-decoration: none;
            color: white;
        }

        .error-message {
            background: rgba(244, 67, 54, 0.2);
            border: 1px solid #f44336;
            color: #fff;
            padding: 0.75rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .field-error {
            color: #f44336;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .divider {
            text-align: center;
            margin: 1rem 0;
            color: rgba(255, 255, 255, 0.6);
        }
    </style>
</head>
<body>
<div class="login-container">
    <div class="logo">ASCENSION TRACKER</div>

    <form asp-action="Login" method="post" id="loginForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-message">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="form-group">
            <label asp-for="EmailOrUsername">Email or Username</label>
            <input asp-for="EmailOrUsername" type="text" placeholder="Enter your email or username" />
            <span asp-validation-for="EmailOrUsername" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="checkbox-group">
            <input asp-for="RememberMe" type="checkbox" />
            <label asp-for="RememberMe">Remember me</label>
        </div>

        <!-- Admin Mode Checkbox (visible) -->
        <div class="admin-mode-group" onclick="toggleAdminMode()">
            <input type="checkbox" id="AdminModeCheckbox" onclick="event.stopPropagation(); toggleAdminMode();" />
            <label for="AdminModeCheckbox" onclick="event.stopPropagation();">
                <span class="admin-icon">🛡️</span>
                <span>Login as Admin (Database Management)</span>
            </label>
        </div>

        <!-- Hidden input that will actually be submitted -->
        <input type="hidden" id="AdminMode" name="AdminMode" value="false" />

        <button type="submit" class="btn-primary" id="loginButton">LOGIN</button>

        <div class="divider">Don't have an account?</div>

        <a href="@Url.Action("Register", "Auth")" class="btn-secondary">REGISTER</a>
    </form>
</div>

<script>
    function toggleAdminMode() {
        const checkbox = document.getElementById('AdminModeCheckbox');
        const hiddenInput = document.getElementById('AdminMode');
        const button = document.getElementById('loginButton');

        // Toggle checkbox
        checkbox.checked = !checkbox.checked;

        // Update hidden input value
        if (checkbox.checked) {
            hiddenInput.value = 'true';
            button.classList.add('admin-mode');
            button.textContent = 'LOGIN TO ADMIN PANEL';
        } else {
            hiddenInput.value = 'false';
            button.classList.remove('admin-mode');
            button.textContent = 'LOGIN';
        }

        console.log('Admin Mode:', hiddenInput.value); // Debug
    }

    // Make sure the initial state is correct
    document.addEventListener('DOMContentLoaded', function() {
        const checkbox = document.getElementById('AdminModeCheckbox');
        const hiddenInput = document.getElementById('AdminMode');
        hiddenInput.value = checkbox.checked ? 'true' : 'false';
    });
</script>
</body>
</html>
