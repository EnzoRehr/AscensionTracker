@model FinalWebapp.Models.UserWorkout

@{
    var workout = Model;
}

@if (workout != null)
{
    var elapsedMinutes = (DateTime.UtcNow - workout.StartTime).TotalMinutes;
    var progressPercentage = Math.Min((elapsedMinutes / workout.EstimatedDurationMinutes) * 100, 100);
    var canClaim = progressPercentage >= 100;
    var remainingMinutes = Math.Max(0, workout.EstimatedDurationMinutes - elapsedMinutes);

    <div class="active-workout-widget" id="activeWorkout">
        <div class="widget-header">
            <h3>🏋️ Active Workout</h3>
            @if (canClaim)
            {
                <span class="ready-badge">✓ Ready!</span>
            }
            else
            {
                <span class="in-progress-badge">⏱️ In Progress</span>
            }
        </div>

        <div class="workout-info">
            @if (workout.WorkoutPlan != null)
            {
                <div class="workout-name">@workout.WorkoutPlan.Name</div>
                <div class="workout-type">
                    <span class="type-badge difficulty-@workout.WorkoutPlan.Difficulty.ToLower()">
                        @workout.WorkoutPlan.Difficulty
                    </span>
                </div>
            }
            else if (workout.Exercise != null)
            {
                <div class="workout-name">Custom Workout</div>
                <div class="workout-details">
                    <div class="detail-item">@workout.Exercise.Name</div>
                    <div class="detail-item">@workout.Sets sets × @workout.Reps reps</div>
                </div>
            }
        </div>

        <div class="progress-section">
            <div class="progress-header">
                <span class="progress-label">Progress</span>
                <span class="progress-percentage" id="progressPercentage">@((int)progressPercentage)%</span>
            </div>
            <div class="progress-bar-container">
                <div class="progress-bar-fill" id="progressBarFill" style="width: @progressPercentage%"></div>
            </div>
            <div class="time-info">
                @if (canClaim)
                {
                    <span class="time-completed" id="timeRemaining">✓ Workout Complete!</span>
                }
                else
                {
                    <span class="time-remaining" id="timeRemaining">@Math.Ceiling(remainingMinutes) minutes remaining</span>
                }
            </div>
        </div>

        <div class="workout-stats">
            <div class="stat-item">
                <div class="stat-icon">💎</div>
                <div class="stat-info">
                    <div class="stat-value">@workout.PointsEarned</div>
                    <div class="stat-label">Points</div>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">⏱️</div>
                <div class="stat-info">
                    <div class="stat-value">@workout.EstimatedDurationMinutes</div>
                    <div class="stat-label">Minutes</div>
                </div>
            </div>
        </div>

        <div id="claimSection">
            @if (canClaim)
            {
                <button onclick="claimWorkout(@workout.UserWorkoutId)" class="claim-btn" id="claimBtn_@workout.UserWorkoutId">
                    <span class="btn-icon">🎁</span> Claim @workout.PointsEarned Points
                </button>
            }
            else
            {
                <div class="waiting-message">
                    <span class="icon">⏳</span>
                    <span>Keep it up! Finish your workout to claim points.</span>
                </div>
            }
        </div>
    </div>

    <style>
        .active-workout-widget {
            background: linear-gradient(135deg, rgba(156, 39, 176, 0.2), rgba(255, 167, 38, 0.2));
            border: 2px solid rgba(156, 39, 176, 0.5);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .widget-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .widget-header h3 {
            color: #ffa726;
            margin: 0;
            font-size: 1.3rem;
        }

        .ready-badge {
            background: linear-gradient(135deg, #5ef38c, #4caf50);
            color: white;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .in-progress-badge {
            background: linear-gradient(135deg, #ffa726, #f57c00);
            color: white;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .workout-name {
            color: white;
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .workout-type {
            margin-bottom: 1rem;
        }

        .type-badge {
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .difficulty-beginner {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
            border: 1px solid #4caf50;
        }

        .difficulty-intermediate {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border: 1px solid #ffc107;
        }

        .difficulty-advanced {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border: 1px solid #f44336;
        }

        .workout-details {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 1rem;
        }

        .detail-item {
            margin-bottom: 0.3rem;
        }

        .progress-section {
            margin: 1.5rem 0;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .progress-label {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 600;
        }

        .progress-percentage {
            color: #ffa726;
            font-weight: bold;
        }

        .progress-bar-container {
            height: 12px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 0.5rem;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #9c27b0, #ffa726);
            border-radius: 6px;
            transition: width 1s ease;
        }

        .time-info {
            text-align: center;
        }

        .time-remaining, .time-completed {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .time-completed {
            color: #5ef38c;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .workout-stats {
            display: flex;
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .stat-item {
            flex: 1;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .stat-icon {
            font-size: 2rem;
        }

        .stat-value {
            color: #ffa726;
            font-size: 1.5rem;
            font-weight: bold;
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.85rem;
        }

        .claim-btn {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #5ef38c, #4caf50);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .claim-btn:hover {
            background: linear-gradient(135deg, #4caf50, #388e3c);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(94, 243, 140, 0.4);
        }

        .claim-btn:disabled {
            background: rgba(128, 128, 128, 0.3);
            cursor: not-allowed;
            transform: none;
        }

        .waiting-message {
            text-align: center;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            color: rgba(255, 255, 255, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .waiting-message .icon {
            font-size: 1.5rem;
        }

        .success-toast {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #5ef38c, #4caf50);
            color: white;
            padding: 1rem 2rem;
            border-radius: 12px;
            font-weight: bold;
            box-shadow: 0 4px 16px rgba(94, 243, 140, 0.5);
            z-index: 1000;
            animation: slideIn 0.3s ease;
        }

        @@keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .fade-out {
            animation: fadeOut 0.5s ease forwards;
        }

        @@keyframes fadeOut {
            to {
                opacity: 0;
                transform: scale(0.9);
            }
        }
    </style>

    <script>
        // Auto-update progress every 10 seconds
        let updateInterval;
        const startTime = new Date('@workout.StartTime.ToString("o")');
        const duration = @workout.EstimatedDurationMinutes;
        const workoutId = @workout.UserWorkoutId;

        function updateProgress() {
            const now = new Date();
            const elapsed = (now - startTime) / 1000 / 60; // minutes
            const percentage = Math.min((elapsed / duration) * 100, 100);
            const remaining = Math.max(0, duration - elapsed);

            // Update progress bar
            const progressBar = document.getElementById('progressBarFill');
            const progressText = document.getElementById('progressPercentage');
            const timeText = document.getElementById('timeRemaining');
            const claimSection = document.getElementById('claimSection');

            if (progressBar && progressText) {
                progressBar.style.width = percentage + '%';
                progressText.textContent = Math.floor(percentage) + '%';
            }

            if (timeText) {
                if (percentage >= 100) {
                    timeText.className = 'time-completed';
                    timeText.textContent = '✓ Workout Complete!';

                    // Show claim button if not already showing
                    if (claimSection && !document.getElementById('claimBtn_' + workoutId)) {
                        claimSection.innerHTML = `
                            <button onclick="claimWorkout(${workoutId})" class="claim-btn" id="claimBtn_${workoutId}">
                                <span class="btn-icon">🎁</span> Claim @workout.PointsEarned Points
                            </button>
                        `;

                        // Update badge
                        const badge = document.querySelector('.in-progress-badge');
                        if (badge) {
                            badge.className = 'ready-badge';
                            badge.textContent = '✓ Ready!';
                        }
                    }
                } else {
                    timeText.className = 'time-remaining';
                    timeText.textContent = Math.ceil(remaining) + ' minutes remaining';
                }
            }
        }

        // Update immediately and then every 10 seconds
        updateProgress();
        updateInterval = setInterval(updateProgress, 10000);

        function claimWorkout(workoutId) {
            clearInterval(updateInterval); // Stop updates

            const btn = document.getElementById('claimBtn_' + workoutId);
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-icon">⏳</span> Claiming...';

            fetch('/Home/ClaimWorkout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ userWorkoutId: workoutId })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showSuccessMessage(`🎉 +${data.pointsEarned} points earned! Total: ${data.newTotalPoints} points`);

                        // Fade out the widget
                        const widget = document.getElementById('activeWorkout');
                        widget.classList.add('fade-out');

                        // Replace with "No Active Workout" after animation
                        setTimeout(() => {
                            widget.outerHTML = `
                            <div class="no-workout-widget">
                                <div class="icon">💪</div>
                                <h3>Workout Complete!</h3>
                                <p>Great job! You earned ${data.pointsEarned} points.</p>
                                <a href="/Home/StartWorkout" class="start-workout-link">
                                    Start Another Workout →
                                </a>
                            </div>
                            <style>
                                .no-workout-widget {
                                    background: rgba(94, 243, 140, 0.1);
                                    border: 2px solid rgba(94, 243, 140, 0.5);
                                    border-radius: 16px;
                                    padding: 2rem;
                                    text-align: center;
                                    margin-bottom: 2rem;
                                    animation: slideIn 0.5s ease;
                                }
                                .no-workout-widget .icon {
                                    font-size: 3rem;
                                    margin-bottom: 1rem;
                                }
                                .no-workout-widget h3 {
                                    color: #5ef38c;
                                    margin-bottom: 0.5rem;
                                }
                                .no-workout-widget p {
                                    color: rgba(255, 255, 255, 0.8);
                                    margin-bottom: 1rem;
                                    font-size: 1.1rem;
                                }
                                .start-workout-link {
                                    display: inline-block;
                                    padding: 0.75rem 1.5rem;
                                    background: linear-gradient(135deg, #9c27b0, #7b1fa2);
                                    color: white;
                                    text-decoration: none;
                                    border-radius: 10px;
                                    font-weight: 600;
                                    transition: all 0.3s ease;
                                }
                                .start-workout-link:hover {
                                    background: linear-gradient(135deg, #7b1fa2, #6a1b9a);
                                    transform: translateY(-2px);
                                }
                            </style>
                        `;
                        }, 500);
                    } else {
                        alert(data.message || 'Failed to claim workout');
                        btn.disabled = false;
                        btn.innerHTML = '<span class="btn-icon">🎁</span> Claim Points';
                        updateInterval = setInterval(updateProgress, 10000); // Resume updates
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred. Please try again.');
                    btn.disabled = false;
                    btn.innerHTML = '<span class="btn-icon">🎁</span> Claim Points';
                    updateInterval = setInterval(updateProgress, 10000); // Resume updates
                });
        }

        function showSuccessMessage(message) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'success-toast';
            messageDiv.textContent = message;
            document.body.appendChild(messageDiv);
            setTimeout(() => messageDiv.remove(), 4000);
        }

        // Clean up interval when page unloads
        window.addEventListener('beforeunload', () => {
            if (updateInterval) clearInterval(updateInterval);
        });
    </script>
}
else
{
    <div class="no-workout-widget">
        <div class="icon">💪</div>
        <h3>No Active Workout</h3>
        <p>Start a workout to track your progress!</p>
        <a href="/Home/StartWorkout" class="start-workout-link">
            Start Workout →
        </a>
    </div>

    <style>
        .no-workout-widget {
            background: rgba(255, 255, 255, 0.05);
            border: 2px dashed rgba(255, 255, 255, 0.2);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 2rem;
        }

        .no-workout-widget .icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .no-workout-widget h3 {
            color: #ffa726;
            margin-bottom: 0.5rem;
        }

        .no-workout-widget p {
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 1rem;
        }

        .start-workout-link {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: linear-gradient(135deg, #9c27b0, #7b1fa2);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .start-workout-link:hover {
            background: linear-gradient(135deg, #7b1fa2, #6a1b9a);
            transform: translateY(-2px);
        }
    </style>
}
