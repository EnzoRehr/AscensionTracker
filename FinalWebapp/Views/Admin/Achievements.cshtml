@model IEnumerable<FinalWebapp.Models.Achievement>
@{
    ViewData["Title"] = "Achievements Management";
    Layout = "_Layout";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <a href="@Url.Action("Dashboard", "Admin")" class="back-btn">← Back to Dashboard</a>
            <h1>🏆 Achievements Management</h1>
        </div>
        <a href="@Url.Action("CreateAchievement", "Admin")" class="btn-create">
            <span>➕</span>
            <span>Add New Achievement</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <span class="alert-icon">✅</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Achievement Name</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Requirement</th>
                    <th>Points</th>
                    <th>Icon</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var achievement in Model)
                {
                    <tr>
                        <td>@achievement.AchievementId</td>
                        <td>
                            <div class="name-cell">
                                <strong>@achievement.Name</strong>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-category">
                                📁 @achievement.Category.Name
                            </span>
                        </td>
                        <td>
                            <div class="description-cell">
                                @(string.IsNullOrEmpty(achievement.Description) ? "-" : (achievement.Description.Length > 60 ? achievement.Description.Substring(0, 60) + "..." : achievement.Description))
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-requirement">
                                @achievement.RequirementType: @achievement.RequirementValue
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-points">
                                💎 @achievement.PointsAwarded pts
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(achievement.IconPath))
                            {
                                <span class="badge badge-icon">🖼️</span>
                            }
                            else
                            {
                                <span class="badge badge-no-icon">-</span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("EditAchievement", "Admin", new { id = achievement.AchievementId })" class="btn-edit" title="Edit">
                                    ✏️
                                </a>
                                <form asp-action="DeleteAchievement" asp-controller="Admin" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this achievement?');">
                                    <input type="hidden" name="id" value="@achievement.AchievementId" />
                                    <button type="submit" class="btn-delete" title="Delete">
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
.admin-page {
    max-width: 1500px;
    margin: 0 auto;
    padding: 2rem;
    background: #1e1e1e;
    min-height: 100vh;
    color: white;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
}

.back-btn {
    display: inline-block;
    color: #9c27b0;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.3s ease;
}

.back-btn:hover {
    color: #7b1fa2;
}

.page-header h1 {
    color: #ffa726;
    font-size: 2rem;
    margin: 0;
}

.btn-create {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #9c27b0, #7b1fa2);
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-create:hover {
    background: linear-gradient(135deg, #7b1fa2, #6a1b9a);
    transform: translateY(-2px);
}

.alert {
    padding: 1rem;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.alert-success {
    background: rgba(76, 175, 80, 0.2);
    border: 1px solid #4caf50;
    color: #4caf50;
}

.table-container {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table thead {
    background: rgba(255, 255, 255, 0.1);
}

.data-table th {
    padding: 1rem;
    text-align: left;
    color: #ffa726;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.data-table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.data-table tbody tr {
    transition: background 0.3s ease;
}

.data-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.05);
}

.name-cell {
    color: #9c27b0;
}

.description-cell {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    max-width: 200px;
}

.badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-block;
    white-space: nowrap;
}

.badge-category {
    background: linear-gradient(135deg, #ff9800, #f57c00);
    color: white;
}

.badge-requirement {
    background: rgba(33, 150, 243, 0.2);
    color: #2196f3;
}

.badge-points {
    background: linear-gradient(135deg, #9c27b0, #7b1fa2);
    color: white;
}

.badge-icon {
    background: rgba(76, 175, 80, 0.2);
    color: #4caf50;
}

.badge-no-icon {
    background: rgba(158, 158, 158, 0.2);
    color: #9e9e9e;
}

.action-buttons {
    display: flex;
    gap: 0.5rem;
}

.btn-edit, .btn-delete {
    padding: 0.5rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    transition: all 0.3s ease;
}

.btn-edit {
    background: rgba(33, 150, 243, 0.2);
    color: #2196f3;
    text-decoration: none;
    display: inline-block;
}

.btn-edit:hover {
    background: rgba(33, 150, 243, 0.3);
    transform: scale(1.1);
}

.btn-delete {
    background: rgba(244, 67, 54, 0.2);
    color: #f44336;
}

.btn-delete:hover {
    background: rgba(244, 67, 54, 0.3);
    transform: scale(1.1);
}


    .page-header {
        flex-direction: column;
        gap: 1rem;
    }

    .btn-create {
        width: 100%;
        justify-content: center;
    }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        min-width: 1200px;
    }

</style>
