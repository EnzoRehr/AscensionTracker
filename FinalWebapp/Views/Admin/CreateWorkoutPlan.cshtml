@model FinalWebapp.Models.WorkoutPlan
@{
    ViewData["Title"] = "Create Workout Plan";
    Layout = "_Layout";
}

<div class="form-container">
    <div class="form-header">
        <h1>➕ Create New Workout Plan</h1>
        <a asp-action="WorkoutPlans" class="btn-back">← Back to Plans</a>
    </div>

    <form asp-action="CreateWorkoutPlan" method="post" class="admin-form">
        <div class="form-grid">
            <div class="form-group full-width">
                <label asp-for="Name" class="form-label">
                    <span class="label-icon">📋</span> Plan Name *
                </label>
                <input asp-for="Name" class="form-input" placeholder="e.g., Full Body Strength Training" maxlength="200" required />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="form-group full-width">
                <label asp-for="Description" class="form-label">
                    <span class="label-icon">📝</span> Description
                </label>
                <textarea asp-for="Description" class="form-textarea" rows="4" 
                          placeholder="Describe this workout plan, its goals, and who it's for..." maxlength="1000"></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
                <small class="form-hint">Maximum 1000 characters</small>
            </div>

            <div class="form-group">
                <label asp-for="Difficulty" class="form-label">
                    <span class="label-icon">⚡</span> Difficulty Level *
                </label>
                <select asp-for="Difficulty" class="form-select" required>
                    <option value="">Select difficulty...</option>
                    <option value="Beginner">🟢 Beginner</option>
                    <option value="Intermediate">🟡 Intermediate</option>
                    <option value="Advanced">🔴 Advanced</option>
                </select>
                <span asp-validation-for="Difficulty" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="RecommendedDailyFrequency" class="form-label">
                    <span class="label-icon">📅</span> Recommended Weekly Frequency
                </label>
                <input asp-for="RecommendedDailyFrequency" type="number" class="form-input" 
                       min="1" max="7" placeholder="e.g., 3" />
                <span asp-validation-for="RecommendedDailyFrequency" class="validation-error"></span>
                <small class="form-hint">How many days per week?</small>
            </div>

            <div class="form-group">
                <label asp-for="EstimatedDurationMinutes" class="form-label">
                    <span class="label-icon">⏱️</span> Duration (minutes)
                </label>
                <input asp-for="EstimatedDurationMinutes" type="number" class="form-input" 
                       min="5" max="300" placeholder="e.g., 45" />
                <span asp-validation-for="EstimatedDurationMinutes" class="validation-error"></span>
                <small class="form-hint">Estimated time per session</small>
            </div>

            <div class="form-group full-width">
                <label asp-for="ImagePath" class="form-label">
                    <span class="label-icon">🖼️</span> Image URL
                </label>
                <input asp-for="ImagePath" type="url" class="form-input" 
                       placeholder="https://example.com/image.jpg" maxlength="500" />
                <span asp-validation-for="ImagePath" class="validation-error"></span>
                <small class="form-hint">Optional: URL to workout plan image</small>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="WorkoutPlans" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-submit">
                <span class="btn-icon">✓</span> Create Workout Plan
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .form-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .form-header h1 {
        color: #ffa726;
        font-size: 2.5rem;
        margin: 0;
    }

    .btn-back {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .admin-form {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 2rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: span 2;
    }

    .form-label {
        color: #ffa726;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .label-icon {
        font-size: 1.2rem;
    }

    .form-input, .form-select, .form-textarea {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
        outline: none;
        border-color: #9c27b0;
        box-shadow: 0 0 0 3px rgba(156, 39, 176, 0.2);
    }

    .form-textarea {
        resize: vertical;
        font-family: inherit;
    }

    .form-hint {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .validation-error {
        color: #f44336;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-cancel {
        flex: 1;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .btn-submit {
        flex: 1;
        padding: 1rem;
        background: linear-gradient(135deg, #9c27b0, #7b1fa2);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-submit:hover {
        background: linear-gradient(135deg, #7b1fa2, #6a1b9a);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(156, 39, 176, 0.4);
    }

    .btn-icon {
        font-size: 1.2rem;
    }

    
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full-width {
            grid-column: span 1;
        }

        .form-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }
    
</style>
